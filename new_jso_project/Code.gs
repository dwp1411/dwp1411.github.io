function setupDatabase() {
  try {
    const newSpreadsheet = SpreadsheetApp.create('JSO Tracking Data');

    // Observations Tab
    const sheet = newSpreadsheet.getActiveSheet();
    sheet.setName('Observations');
    const headers = [['Timestamp', 'Observation ID', 'Topic', 'Leader', 'Associate', 'Observation Type', 'Original Notes', 'Policy Violated', 'Associate Perspective', 'Action Plan', 'Leader Coaching Notes']];
    sheet.getRange(1, 1, 1, 11).setValues(headers)
         .setFontWeight('bold')
         .setBackground('#d9d9d9');
    sheet.setFrozenRows(1);

    // Activity Log Tab
    const logSheet = newSpreadsheet.insertSheet('Activity Log');
    const logHeaders = [['Timestamp', 'Leader', 'Associate', 'Function', 'Observation Type', 'Duration', 'Total Seconds', 'Total Count', 'Calculated UPH', 'Activity Logs', 'Notes 1', 'Notes 2', 'Notes 3', 'Notes 4', 'Notes 5', 'Notes 6', 'Notes 7', 'Notes 8', 'FB: Pace', 'FB: Skills', 'FB: Training', 'FB: Environment', 'FB: Notes', 'Signature']];
